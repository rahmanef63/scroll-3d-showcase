# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# legacy static build + master asset (18 MB glb) — kept on disk, not in git
/legacy-static/

# convex/_generated is COMMITTED on purpose (self-hosted deploy): the Docker
# build typechecks without running codegen inside the container. Do not ignore it.

# transfer artefacts
*.tar.gz
*.zip

# editors
.vscode/
.idea/
