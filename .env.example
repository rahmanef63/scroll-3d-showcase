# Copy to .env.local. Both are OPTIONAL: with neither set the site still builds
# and renders from the bundled /rahman-3d.glb and the slice's default keyframes.

# Convex deployment URL, e.g. https://api-scroll3d.rahmanef.com
# Unset  -> no backend: the public page uses defaults and /studio opens read-only
#           on the bundled model.
NEXT_PUBLIC_CONVEX_URL=

# Shared secret for /studio. Unset -> the studio is locked shut (fail closed).
# Must be set BOTH here and on the Convex deployment, because the mutations
# compare the token server-side:
#   npx convex env set STUDIO_TOKEN <same-value>
# Never prefixed with NEXT_PUBLIC_ — it must not reach the client bundle.
STUDIO_TOKEN=
